{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": [
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "routeTree.gen.ts",
        "src/lib/settings/settings.generated.ts",
        "src/lib/backend/protocol.ts",
        "src/lib/backend/transport/commands.generated.ts",
        "crates/tauri-plugin-prevent-default/assets",
        "crates/tauri-plugin-window-controls-overlay/permissions",
        "crates/tauri-plugin-window-controls-overlay/src/init.js",
        "crates/highlight/syntaxes/**"
    ],
    "printWidth": 80,
    "trailingComma": "es5",
    "tabWidth": 4,
    "sortImports": true,
    "sortTailwindcss": {
        "stylesheet": "src/styles.css",
        "functions": ["cn", "cva"]
    },
    "sortPackageJson": true
}
